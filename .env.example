# Postgres (Neon or Supabase). Leave unset to run the site on the built-in placeholder content.
DATABASE_URL=postgres://user:password@host:5432/sobjo

# Any long random string. Signs admin login sessions.
PAYLOAD_SECRET=change-me

# Public URL of the site, used by Payload for links and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token. When set, uploads in /addpost go to Blob instead of the local /media folder.
BLOB_READ_WRITE_TOKEN=

# ---- The private /update-site editor (see "The /update-site editor" in the README) ----

# Any long random string; signs the editor's sign-in cookie. Make one with: npx auth secret
AUTH_SECRET=

# Google sign-in. Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URIs: https://sobjo.com/api/auth/callback/google and http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who may sign in, separated by commas.
ALLOWED_EMAILS=

# GitHub fine-grained token with "Contents: read and write" on sobjo/sobjo.com. Expires; renew it every Jan 1.
GITHUB_TOKEN=
# Optional. Defaults: sobjo/sobjo.com and main.
GITHUB_REPO=
GITHUB_BRANCH=
