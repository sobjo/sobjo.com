# Postgres (Neon or Supabase). Leave unset to run the site on the built-in placeholder content.
DATABASE_URL=postgres://user:password@host:5432/sobjo

# Any long random string. Signs admin login sessions.
PAYLOAD_SECRET=change-me

# Public URL of the site, used by Payload for links and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token. When set, uploads in /addpost go to Blob instead of the local /media folder.
BLOB_READ_WRITE_TOKEN=
